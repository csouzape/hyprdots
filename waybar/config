{
    "layer": "top", 
    "position": "top",
    "output": "eDP-1",     
    "height": 24, 
    "spacing": 0, 
    "modules-left": ["hyprland/workspaces"], 
    "modules-center": ["hyprland/window"], 
    "modules-right": ["battery", "pulseaudio", "clock", "network" "tray"], 

    "hyprland/workspaces": {
        "format": "{name}", 
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 6 
        }
    },
    "hyprland/window": {
        "format": "{title}", 
        "separate-outputs": true,
        "max-length": 50
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}", 
        "format-icons": ["", "", "", "", "", "", "", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}", 
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol"
    },
    "clock": {
        "format": "{:%H:%M %p}", // Relógio como "01:28 PM"
        "tooltip-format": "{:%Y-%m-%d | %H:%M}"
    },
    "network": {
    "format-ethernet": "󰈀",  
    "format-linked": "󰈀 (No IP)",
    "format-disconnected": "󰲜", 
    "tooltip-format-wifi": "{essid} ({signaldBm}dBm) ",
    "tooltip-format-ethernet": "{ifname} 󰈀",
    "tooltip-format-disconnected": "Desconectado",
    "on-click": "nm-connection-editor"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8 // Ícones da tray (volume, rede extra, etc.)
    }
}
