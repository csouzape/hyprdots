{
    "layer": "top", 
    "position": "top",
    "output": "HDMI-A-1",     
    "height": 20, 
    "spacing": 0, 
    "modules-left": ["hyprland/workspaces"], 
    "modules-center": ["hyprland/window"], 
    "modules-right": ["battery", "pulseaudio", "custom/separator", "clock", "custom/separator", "network", "tray", "custom/separator" ,"custom/power"], 

    "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false
    },
    
    "hyprland/window": {
        "format": "{title}", 
        "separate-outputs": true,
        "max-length": 50
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}", 
        "format-icons": [],
        "tooltip-format": "{timeTo}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}", 
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol"
    },
    "custom/separator": {
    "format": "|",
    "interval": "once",
    "tooltip": false
    },
    "clock": {
        "format": "{:%H:%M %p}", // Relógio como "01:28 PM"
        "tooltip-format": "{:%Y-%m-%d | %H:%M}"
    },
    "network": {
    "format-ethernet": "󰈀",  
    "format-linked": "󰈀 (No IP)",
    "format-disconnected": "󰲜", 
    "tooltip-format-wifi": "{essid} ({signaldBm}dBm) ",
    "tooltip-format-ethernet": "{ifname} 󰈀",
    "tooltip-format-disconnected": "Desconectado",
    "on-click": "nm-connection-editor"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8 // Ícones da tray (volume, rede extra, etc.)
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "echo -e 'Desligar\nReiniciar\nSuspender\nSair' | rofi -dmenu -p 'Sistema:' -i | xargs -I{} bash -c 'case {} in Desligar) shutdown now;; Reiniciar) reboot;; Suspender) systemctl suspend;; Sair) hyprlandctl dispatch exit;; esac'"
    }
}